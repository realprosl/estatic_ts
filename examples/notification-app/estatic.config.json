{
  "entry": "src/main.ts",
  "moduleRoots": ["src"],
  "aliases": {
    "@domain": "src/domain",
    "@shared": "src/shared"
  },
  "output": {
    "cpp": ".build/app.cpp",
    "binary": ".build/app"
  },
  "compiler": {
    "enabled": true,
    "command": "g++",
    "flags": ["-std=c++20", "-O2", "-pthread", "-fno-exceptions"],
    "linkFlags": []
  },
  "incremental": {
    "enabled": true,
    "cacheDirectory": ".build/cache",
    "generatedDirectory": ".build/generated"
  }
}
