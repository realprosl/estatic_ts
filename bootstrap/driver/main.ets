import {compileNative} from "./build";
import {ModuleLoader,LoaderOptions,PathAlias} from "../modules/loader";
import {analyzeProject} from "../checker/expansion";
import {lowerProject} from "../ir/lower";
import {IrProject,IrIssue,IrSource} from "../ir/model";
import {formatIr} from "../ir/format";
import {generateCppFromIr,IrCppResult} from "../backend/cpp/generator";
import {parseIrProject} from "../backend/cpp/decode";
import {formatCppResult} from "../backend/cpp/wire";
import {parseConfig,configStrings} from "./config";
import {environment,exists,readText,stdinText,writeText,hostError,launch,poll,pause,files,compilerHome,objectKeys,directories} from "./host";
import {configureProgress,progressStart,progressDetail,progressTick,progressFinish,progressSummary} from "../progress/progress";
function driverError(message:string,status:number=1):void{progressFinish(false);printError(message);exitProcess(status);}
function checkedWrite(path:string,text:string):void{if(!writeText(path,text))driverError(hostError());}
function checkedRead(path:string):string{const text=readText(path);if(hostError()!="")driverError(hostError());return text;}
function pathAt(base:string,path:string):string{return normalizePath(path.startsWith("/")?path:base+"/"+path);}
function parent(path:string):string{let end:number=-1;for(let k:number=0;k<path.length;k=k+1)if(path.charAt(k)=="/")end=k;return end<0?".":path.slice(0,end);}
function stem(path:string):string{let start:number=0;let end:number=path.length;for(let k:number=0;k<path.length;k=k+1){if(path.charAt(k)=="/"){start=k+1;end=path.length;}else if(path.charAt(k)==".")end=k;}return path.slice(start,end);}
function execute(command:string[],output:string="",errors:string=""):number{progressDetail(command.join(" "));const pid=launch(command,output,errors);if(pid<0)driverError(hostError());let status=poll(pid);while(status<0){progressTick();pause(80);status=poll(pid);}return status;}
function help():string{return "Uso: etsc init [directorio] | update-types [directorio] | build|run [entrada.ets] [opciones]\n  --check                  Verificar sin generar\n  -o archivo.cpp           Ruta C++\n  --binary archivo         Ruta ejecutable (con build)\n  --from-ir archivo        Generar desde ets-ir-2 verificado\n  --emit-ir archivo        Guardar IR\n  --config archivo         JSON u objeto declarativo\n  --root ruta | --alias nombre ruta | --cache ruta\n  --cxx compilador | --cxx-flag flag | --link-flag flag\n  --verbose | --no-progress\n  init [directorio] | update-types [directorio]\n  --help | -h | -H | --version | -version | -v | -V | /V\n";}
function sourceIr(entry:string,options:LoaderOptions,verbose:boolean):IrProject{
 let loader=new ModuleLoader(options);const graph=loader.load(entry);const project=analyzeProject(graph,verbose);progressDetail("Generando IR verificado");let ir=lowerProject(project.graph,project.binding,project.checked,verbose);
 let diagnostics=project.graph.diagnostics;for(const d of project.binding.diagnostics)diagnostics.push(d);for(const d of project.checked.diagnostics)diagnostics.push(d);
 let seen:string[]=[];for(const d of diagnostics){const key=d.file+":"+numberToString(d.token.offset)+":"+d.code+":"+d.message;if(!seen.includes(key)){seen.push(key);ir.diagnostics.push(new IrIssue(d.code,d.message,new IrSource("","",d.file,-1,d.token.offset,d.endToken.endOffset)));}}
 if(!ir.success||ir.diagnostics.length>0){for(const d of ir.diagnostics)printError(d.source.file+":"+numberToString(d.source.start)+": "+d.code+": "+d.message);driverError("No se produjo IR verificado");}return ir;
}
function initialize(root:string,directory:string,update:boolean):void{
 const target=directory+"/types/estatic.d.ts";const types=checkedRead(root+"/types/estatic.d.ts");if(update){if(exists(target)){const previous=checkedRead(target);if(previous==types)return;if(exists(target+".bak"))driverError("Ya existe "+target+".bak");checkedWrite(target+".bak",previous);}checkedWrite(target,types);return;}
 let templates=root+"/templates";if(!exists(templates))templates=root+"/native-cpp/templates";if(!exists(templates))driverError("Faltan las plantillas de instalación");const paths=files(templates);if(exists(target))driverError("No se sobrescribe "+target);for(const path of paths)if(exists(directory+"/"+path))driverError("No se sobrescribe "+directory+"/"+path);for(const path of paths)if(path!="types/estatic.d.ts")checkedWrite(directory+"/"+path,checkedRead(templates+"/"+path));checkedWrite(target,types);for(const folder of ["cache","generated","runtime"])if(!directories(directory+"/.build/"+folder))driverError(hostError());
}
function main():void{
 let args:string[]=[];for(let k:number=1;k<argumentCount();k=k+1)args.push(argument(k));
 if(args.length==1&&args[0]=="--codegen-json"){const wireProject=parseIrProject(stdinText());const wireResult=generateCppFromIr(wireProject);print(formatCppResult(wireResult));return;}
 if(args.length==1&&["--help","-h","-H"].includes(args[0])){print(help());return;}
 if(args.length==1&&["--version","-version","-v","-V","/V"].includes(args[0])){const metadata=JSON.parseValue(checkedRead(compilerHome()+"/package.json"));print("etsc "+jsonAsString(jsonObjectGet(metadata,"version"))+" (v"+numberToString(jsonAsNumber(jsonObjectGet(metadata,"estaticRevision")))+")");return;}
 let root=environment("ESTC_ROOT");if(root=="")root=compilerHome();root=normalizePath(root);
 if(args.length>0&&(args[0]=="init"||args[0]=="update-types")){if(args.length>3||(args.length==3&&args[2]!="--verbose"))driverError(help(),2);configureProgress(args.length==3,false);progressStart(args[0]=="init"?"Creando proyecto":"Actualizando tipos");initialize(root,args.length>=2?args[1]:".",args[0]=="update-types");progressSummary();return;}
 let build:boolean=false;let run:boolean=false;let check:boolean=false;let verbose:boolean=false;let animate:boolean=true;let entry:string="";let output:string="";let binary:string="";let fromIr:string="";let emitIr:string="";let configPath:string="";let cxx:string="";let options=new LoaderOptions();let flags:string[]=[];let links:string[]=[];let programArgs:string[]=[];
 let at:number=0;if(args.length>0&&(args[0]=="build"||args[0]=="run")){build=true;run=args[0]=="run";at=1;}
 for(;at<args.length;at=at+1){const arg=args[at];if(arg=="--"){for(let k:number=at+1;k<args.length;k=k+1)programArgs.push(args[k]);break;}if(arg=="--verbose"){verbose=true;continue;}if(arg=="--no-progress"){animate=false;continue;}if(arg=="--build"){build=true;continue;}if(arg=="--run"){run=true;build=true;continue;}if(arg=="--check"){check=true;continue;}
 if(["-o","--binary","--from-ir","--emit-ir","--config","--cxx","--root","--cache","--alias","--cxx-flag","--link-flag"].includes(arg)){at+=1;if(at>=args.length)driverError("Falta un valor para "+arg,2);const value=args[at];if(value.startsWith("-")&&arg!="--cxx-flag"&&arg!="--link-flag")driverError("Falta un valor para "+arg,2);if(arg=="-o")output=value;else if(arg=="--binary")binary=value;else if(arg=="--from-ir")fromIr=value;else if(arg=="--emit-ir")emitIr=value;else if(arg=="--config")configPath=value;else if(arg=="--cxx")cxx=value;else if(arg=="--cache")options.cacheDirectory=value;else if(arg=="--root")options.roots.push(normalizePath(value));else if(arg=="--cxx-flag")flags.push(value);else if(arg=="--link-flag")links.push(value);else if(arg=="--alias"){at+=1;if(at>=args.length)driverError("Falta la ruta del alias",2);options.aliases.push(new PathAlias(value,args[at]));}continue;}
 if(arg.startsWith("-")||entry!="")driverError("Argumento inesperado: "+arg,2);entry=arg;}
 if(entry!=""&&fromIr!="")driverError("Usa una fuente o --from-ir",2);if(check&&(build||run||output!=""||binary!=""))driverError("--check no admite generación o ejecución",2);if(programArgs.length>0&&!run)driverError("Los argumentos del programa requieren run",2);
 configureProgress(verbose,animate);progressStart("Cargando configuración");if(configPath==""&&entry==""&&fromIr==""){if(exists("estatic.config.json"))configPath="estatic.config.json";else if(exists("estatic.config.ts"))configPath="estatic.config.ts";}
 let config:JsonValue=JSON.parseValue("{}");let base:string=".";if(configPath!=""){config=parseConfig(checkedRead(configPath));base=parent(configPath);}const configuredEntry=jsonAsString(jsonObjectGet(config,"entry"));if(entry==""&&fromIr==""&&configuredEntry!="")entry=pathAt(base,configuredEntry);if(entry==""&&fromIr=="")driverError(help(),2);
 const incremental=jsonObjectGet(config,"incremental");const incrementalEnabled=jsonAsBool(jsonObjectGet(incremental,"enabled"));const cache=incrementalEnabled?pathAt(base,jsonAsString(jsonObjectGet(incremental,"cacheDirectory"))):"";if(options.cacheDirectory==""&&cache!="")options.cacheDirectory=cache+"/syntax";const generatedDirectory=incrementalEnabled?jsonAsString(jsonObjectGet(incremental,"generatedDirectory")):"";
 for(const path of configStrings(jsonObjectGet(config,"moduleRoots")))options.roots.push(pathAt(base,path));const aliases=jsonObjectGet(config,"aliases");for(const name of objectKeys(aliases))options.aliases.push(new PathAlias(name,pathAt(base,jsonAsString(jsonObjectGet(aliases,name)))));
 options.verbose=verbose;progressStart(fromIr==""?"Analizando fuentes y verificando IR":"Leyendo IR");const ir:IrProject=fromIr==""?sourceIr(entry,options,verbose):parseIrProject(checkedRead(fromIr));if(emitIr!="")checkedWrite(emitIr,formatIr(ir)+"\n");if(check){progressSummary();return;}
 progressStart("Generando C++ desde IR verificado");const generated=generateCppFromIr(ir);const outConfig=jsonObjectGet(config,"output");const compiler=jsonObjectGet(config,"compiler");if(output==""){const configured=jsonAsString(jsonObjectGet(outConfig,"cpp"));output=(configured!=""?pathAt(base,configured):"build/"+stem(fromIr==""?entry:fromIr)+".cpp");}progressStart("Guardando resultados");checkedWrite(output,generated.cpp);if(generatedDirectory!="")checkedWrite(pathAt(base,generatedDirectory)+"/"+stem(output)+".cpp",generated.cpp);
 if(build||jsonAsBool(jsonObjectGet(compiler,"enabled"))){if(binary==""){const configured=jsonAsString(jsonObjectGet(outConfig,"binary"));binary=(configured!=""?pathAt(base,configured):output+".bin");}if(cxx=="")cxx=jsonAsString(jsonObjectGet(compiler,"command"));if(cxx=="")cxx=environment("CXX");if(cxx==""&&exists(root+"/installation.json"))cxx=jsonAsString(jsonObjectGet(JSON.parseValue(checkedRead(root+"/installation.json")),"compiler"));if(cxx=="")cxx="g++";let compileFlags=configStrings(jsonObjectGet(compiler,"flags"));for(const flag of flags)compileFlags.push(flag);let linkFlags=configStrings(jsonObjectGet(compiler,"linkFlags"));for(const flag of links)linkFlags.push(flag);for(const library of configStrings(jsonObjectGet(config,"linkLibraries")))linkFlags.push("-l"+library);compileNative(generated,output,binary,root,cxx,compileFlags,linkFlags,cache);}
 progressSummary();if(run){let command:string[]=[normalizePath(binary)];for(const arg of programArgs)command.push(arg);exitProcess(execute(command));}
}
main();
