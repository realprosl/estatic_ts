// Declarative configuration only: importing TypeScript never executes it.
class ConfigReader {
 source:string;at:number;
 constructor(source:string){this.source=source;this.at=0;}
 fail():void{printError("Configuración no declarativa o incompleta; utiliza un objeto literal o JSON");exitProcess(2);}
 skip():void{while(this.at<this.source.length){const c=this.source.charAt(this.at);if(c==" "||c=="\n"||c=="\r"||c=="\t"){this.at+=1;continue;}if(this.source.slice(this.at,this.at+2)=="//"){while(this.at<this.source.length&&this.source.charAt(this.at)!="\n")this.at+=1;continue;}if(this.source.slice(this.at,this.at+2)=="/*"){this.at+=2;while(this.at<this.source.length&&this.source.slice(this.at,this.at+2)!="*/")this.at+=1;if(this.at>=this.source.length)this.fail();this.at+=2;continue;}break;}}
 take(c:string):boolean{this.skip();if(this.source.charAt(this.at)!=c)return false;this.at+=1;return true;}
 word():string{this.skip();const start=this.at;while(this.at<this.source.length&&"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_$".includes(this.source.charAt(this.at)))this.at+=1;if(start==this.at)this.fail();return this.source.slice(start,this.at);}
 quoted():string{this.skip();const delimiter=this.source.charAt(this.at);this.at+=1;let value:string="";while(this.at<this.source.length){let c=this.source.charAt(this.at);this.at+=1;if(c==delimiter)return "\""+jsonEscape(value)+"\"";if(c=="\\"){c=this.source.charAt(this.at);this.at+=1;if(c=="n")c="\n";else if(c=="r")c="\r";else if(c=="t")c="\t";else if(c!="\\"&&c!="\""&&c!="'")this.fail();}value+=c;}this.fail();return "";}
 value():string{this.skip();if(this.take("{")){let fields:string[]=[];while(!this.take("}")){this.skip();const c=this.source.charAt(this.at);const key:string=c=="\""||c=="'"?this.quoted():"\""+jsonEscape(this.word())+"\"";if(!this.take(":"))this.fail();fields.push(key+":"+this.value());if(this.take("}"))break;if(!this.take(","))this.fail();}return "{"+fields.join(",")+"}";}if(this.take("[")){let values:string[]=[];while(!this.take("]")){values.push(this.value());if(this.take("]"))break;if(!this.take(","))this.fail();}return "["+values.join(",")+"]";}const c=this.source.charAt(this.at);if(c=="\""||c=="'")return this.quoted();const start=this.at;while(this.at<this.source.length&&!",}] \t\r\n".includes(this.source.charAt(this.at)))this.at+=1;if(start==this.at)this.fail();return this.source.slice(start,this.at);}
 parse():JsonValue{this.skip();if(this.source.slice(this.at,this.at+6)=="import"){while(this.at<this.source.length&&this.source.charAt(this.at)!=";")this.at+=1;this.at+=1;}this.skip();if(this.source.slice(this.at,this.at+6)=="export"){if(this.word()!="export"||this.word()!="default")this.fail();}const encoded=this.value();this.skip();if(this.source.slice(this.at,this.at+2)=="as"){if(this.word()!="as"||this.word()!="const")this.fail();}else if(this.source.slice(this.at,this.at+9)=="satisfies"){this.word();this.word();}this.take(";");this.skip();if(this.at!=this.source.length)this.fail();const result=JSON.parseValue(encoded);if(!jsonIsObject(result))this.fail();return result;}
}
export function parseConfig(source:string):JsonValue{let reader=new ConfigReader(source);return reader.parse();}
export function configStrings(value:JsonValue):string[]{let values:string[]=[];for(let k:number=0;k<jsonArrayLength(value);k=k+1)values.push(jsonAsString(jsonArrayGet(value,k)));return values;}
